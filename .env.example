# Copy to .env and adjust. For local dev without Neon, set
# DB_ENGINE=django.db.backends.sqlite3 and leave the DB_* values blank.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — defaults to local SQLite for dev/tests.
# For production (Neon PostgreSQL) set DB_ENGINE=django.db.backends.postgresql
# plus DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT (copy from your Neon
# connection string: postgresql://USER:PASSWORD@HOST:PORT/DBNAME).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Scraper tokens / keys (read from the environment at fetch time).
# EthioJobs JWT — get a fresh one from the Network tab on ethiojobs.net/jobs.
ETHIOJOBS_TOKEN=
# Optional free Jina Reader API key (raises the free-tier request limit for
# sources that fetch through the r.jina.ai relay, e.g. GeezJobs).
JINA_API_KEY=
# Anti-bot rotation backends — see CLOUDFLARE.md for the full strategy.
# All optional: the scraper uses whichever are configured. The rotation
# picks the cheapest available backend first. To add a new site behind
# Cloudflare, just set pagination.relay="cloudflare_rotate" in seed_sources.
# To add a new backend, subclass CloudflareBackend in cloudflare_backends.py.
SCRAPE_DO_API_KEY=        # scrape.do → Dashboard → API Token (1 credit/req, 1,000 free/mo)
SCRAPEBADGER_API_KEY=     # scrapebadger.com → Dashboard → API Key (1-3 credits/req, 1,000 free/mo)
ZENROWS_API_KEY=          # zenrows.com → Dashboard → API Keys (25 credits/req, 5,000 free/mo)
SCRAPERAPI_KEY=           # scraperapi.com → Dashboard → API Key (5-75 credits/req, 1,000 free/mo)
SCRAPFLY_API_KEY=         # scrapfly.io → Dashboard → API Keys (30-80 credits/req, 1,000 free/mo)

# Telegram notifications (optional) — sends the scrape report to your phone
# after every run. Create a bot with @BotFather (free), message it once, then
# get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
# In production (GitHub Actions) these are Actions secrets, not .env values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# per-run = report after every scrape (current, 2 runs/day); daily = only
# send on failures plus one end-of-day digest (for the every-30-min future).
NOTIFY_MODE=per-run
# HH:MM UTC of the final scheduled run of the day — the daily digest is sent
# on that run. 20:30 UTC = 23:30 Addis Ababa time.
DAILY_DIGEST_UTC=20:30
