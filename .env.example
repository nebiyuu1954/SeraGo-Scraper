# Copy to .env and adjust. For local dev without Neon, set
# DB_ENGINE=django.db.backends.sqlite3 and leave the DB_* values blank.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — defaults to local SQLite for dev/tests.
# For production (Neon PostgreSQL) set DB_ENGINE=django.db.backends.postgresql
# plus DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT (copy from your Neon
# connection string: postgresql://USER:PASSWORD@HOST:PORT/DBNAME).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Scraper tokens / keys (read from the environment at fetch time).
# EthioJobs JWT — get a fresh one from the Network tab on ethiojobs.net/jobs.
ETHIOJOBS_TOKEN=
# Optional free Jina Reader API key (raises the free-tier request limit for
# sources that fetch through the r.jina.ai relay, e.g. GeezJobs).
JINA_API_KEY=
