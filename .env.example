# Copy to .env and adjust. Defaults below give a working local SQLite setup.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — defaults to local SQLite for dev/tests.
# For production (Neon PostgreSQL) set DB_ENGINE=django.db.backends.postgresql
# plus DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
