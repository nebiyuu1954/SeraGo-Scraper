# =============================================================================
# SeraGo Scraper — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you have.
# For local dev without Neon, leave DB_* blank (defaults to SQLite).
# =============================================================================

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave blank → auto-uses SQLite.
# Production: set DB_ENGINE=django.db.backends.postgresql and fill in Neon creds.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Scraper Source Tokens ────────────────────────────────────────────────────
# EthioJobs JWT — grab from Network tab on ethiojobs.net/jobs (expires ~daily)
ETHIOJOBS_TOKEN=

# ── Anti-Bot Relay Keys ──────────────────────────────────────────────────────
# All optional — the rotation skips backends with no key.
# See CLOUDFLARE.md for the full strategy.
#
# Two rotation modes:
#   relay_rotate     → Jina first (cheapest), then CF backends as fallback
#                       Used by: GeezJobs (WAF-blocked sites)
#   cloudflare_rotate → CF backends only (no Jina)
#                       Used by: ReporterJobs (Cloudflare-protected sites)
#
# To add a NEW site → just set pagination.relay in seed_sources.py
# To add a NEW backend → subclass CloudflareBackend in cloudflare_backends.py

#   Service            Type     Credits/req   Free tier/mo   Sign up
#   ────────────────── ──────── ───────────── ────────────── ──────────────────────────
#   Firecrawl          Relay    1             1,000          https://firecrawl.dev     → Dashboard → API Key
#   Jina Reader        Relay    1             6,000 (200/day) https://jina.ai           → free API key
#   Scrape.do          API      1             1,000          https://scrape.do          → Dashboard → API Token
#   ScrapeBadger       API      1-3           1,000          https://scrapebadger.com   → Dashboard → API Key
#   ZenRows            API      25            5,000          https://zenrows.com        → Dashboard → API Keys
#   ScraperAPI         API      5-75          1,000          https://scraperapi.com     → Dashboard → API Key
#   ScrapFly           API      30-80         1,000          https://scrapfly.io        → Dashboard → API Keys

# Primary relay (for relay_rotate sources like GeezJobs)
FIRECRAWL_API_KEY=
JINA_API_KEY=

# Anti-bot backends (for cloudflare_rotate and relay_rotate fallback)
SCRAPE_DO_API_KEY=
SCRAPEBADGER_API_KEY=
ZENROWS_API_KEY=
SCRAPERAPI_KEY=
SCRAPFLY_API_KEY=

# ── Telegram Notifications (optional) ────────────────────────────────────────
# Sends the scrape report to your phone after every run.
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message your new bot once
# 3. GET https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# per-run = report after every scrape (current, 2 runs/day)
# daily   = failures only + one end-of-day digest
NOTIFY_MODE=per-run

# HH:MM UTC of the final daily run — digest sent on that run
# 20:30 UTC = 23:30 Addis Ababa time
DAILY_DIGEST_UTC=20:30
